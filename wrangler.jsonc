
{
  "name": "pharma-ai-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-07",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pharma-research-db",
      "database_id": "a34f8467-8a1b-476c-856f-143479336352"
    }
  ],

  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "pharma-research-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "pharma-research-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "retry_delay": 0
      }
    ]
  }
}
